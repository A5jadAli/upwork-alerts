# Copy to .env and fill in. The host sets these as real env vars in production.

# --- LLM filter (OpenAI by default; swap base_url+model for Gemini or Grok) ---
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5-mini
LLM_BASE_URL=https://api.openai.com/v1
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
# Grok:    LLM_BASE_URL=https://api.x.ai/v1                                        LLM_MODEL=grok-3-mini

# --- Email (Gmail SMTP) ---
GMAIL_USER=aliasjid009@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
ALERT_TO=aliasjid009@gmail.com

# --- Runtime ---
POLL_INTERVAL_SECONDS=600
MAX_JOB_AGE_HOURS=1
ALERT_TOP_N=10
# CLIENT_ID and ORG_UID already default correctly in config.py; override only if needed.
